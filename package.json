{
  "name": "fantasy-draft",
  "private": true,
  "description": "Fantasy draft league app. index.html is the app; styles.css is built from it.",
  "scripts": {
    "build:css": "tailwindcss -i src.css -o styles.css --minify",
    "watch:css": "tailwindcss -i src.css -o styles.css --watch",
    "test": "node test_logic.js",
    "vendor:supabase": "cp node_modules/@supabase/supabase-js/dist/umd/supabase.js vendor/supabase.js",
    "build": "npm run build:css && npm run vendor:supabase"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.110.9",
    "tailwindcss": "^3.4.19"
  }
}
